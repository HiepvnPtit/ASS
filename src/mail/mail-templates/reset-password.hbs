<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>

<body style="margin:0;font-family:arial">
    <table style="border:0;width:100%">
        <tr style="background:#eeeeee">
            <td style="padding:20px;color:#808080;text-align:center;font-size:40px;font-weight:600">
                {{app_name}}
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#808080;font-size:16px;font-weight:100">
                {{text1}}<br>
                {{text2}}
            </td>
        </tr>
        <tr>
            <td style="text-align:center;padding:30px">
                <div style="font-size:48px;font-weight:bold;color:#00838f;letter-spacing:8px;font-family:monospace">
                    {{otp}}
                </div>
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#808080;font-size:16px;font-weight:100;text-align:center">
                Mã xác nhận đặt lại mật khẩu của bạn là: <strong>{{otp}}</strong><br>
                Mã này có hiệu lực trong 10 phút.
            </td>
        </tr>
    </table>
</body>

</html>